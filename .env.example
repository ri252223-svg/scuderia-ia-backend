# Copie para .env e preencha com os valores reais.
# Este arquivo (.env) NUNCA deve ser commitado nem enviado ao frontend.

PORT=3000
NODE_ENV=production

# Banco de dados — obrigatório pra Fase 5 funcionar.
# Local: postgres://scuderia:SENHA@localhost:5432/scuderia_ia
# Supabase/produção: connection string do painel do projeto.
DATABASE_URL=postgres://usuario:senha@host:5432/scuderia

# Autenticação — obrigatório pra Fase 5 funcionar.
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio

# Camada de IA (Fase de IA, item 2) — sem isso, a Scuderia continua
# funcionando normalmente, só usando o parser de regras como fallback
# pra 100% dos comandos (nada quebra, ela só não entende linguagem
# natural livre ainda). Chave da API da Anthropic (console.anthropic.com).
ANTHROPIC_API_KEY=
# Modelo usado pela camada de IA. Recomendado: claude-sonnet-5.
AI_MODEL=claude-sonnet-5

# ---- Fases futuras (não usadas ainda — WhatsApp/Pix continuam simulados) ----

# Meta / WhatsApp Business Platform
WHATSAPP_TOKEN=token_permanente_da_meta
WHATSAPP_VERIFY_TOKEN=escolha_uma_string_para_validar_o_webhook
WHATSAPP_PHONE_NUMBER_ID=id_do_numero_configurado_na_meta
WHATSAPP_APP_SECRET=app_secret_do_app_meta

# Mercado Pago
# Mercado Pago — modelo MARKETPLACE: cada empresa conecta a própria
# conta (OAuth), o dinheiro cai direto pra ela, nunca pra essa conta
# "global". MP_ACCESS_TOKEN abaixo não cobra ninguém — só ficaria
# reservado pra uma eventual assinatura da própria Siky, se um dia
# existir; o que cobra os clientes é sempre o token de cada empresa.
MP_ACCESS_TOKEN=access_token_de_producao_do_mercado_pago
MP_WEBHOOK_SECRET=segredo_configurado_no_painel_do_mercado_pago
# Client ID e Secret da aplicação (painel do Mercado Pago > sua app >
# credenciais/OAuth) — usados só pra autorizar a conexão de cada
# empresa, nunca pra cobrar diretamente.
MP_CLIENT_ID=client_id_da_aplicacao_no_mercado_pago
MP_CLIENT_SECRET=client_secret_da_aplicacao_no_mercado_pago
# URL pública do backend (sem barra no final) — usada pra montar a URL
# de retorno do OAuth. Em produção, é a URL do Railway.
PUBLIC_BASE_URL=https://scuderia-ia-backend-production.up.railway.app
